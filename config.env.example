# Copy to config.env and fill in. No secrets here - the bot token lives in
# ~/.claude/channels/discord/.env (DISCORD_BOT_TOKEN=...).

# Your Discord user ID (Settings > Advanced > Developer Mode, then right-click yourself > Copy User ID).
# The bot ignores everyone else.
OWNER_ID=

# Server IDs to listen on, comma-separated. Empty = every server the bot is in.
GUILD_IDS=

# Case-insensitive regex that summons the bot in server channels (besides @mention and
# replying to the bot). Default: the word "claude" anywhere, which also covers "!claude".
PREFIX_PATTERN='\bclaude\b'

# Model for the session (alias like "sonnet" or a full model ID).
MODEL=claude-sonnet-5-5

# After this many idle minutes, if the context is above COMPACT_MIN_TOKENS,
# idle_compact.py sends /compact so the next message is cheap again.
IDLE_MINUTES=50
COMPACT_MIN_TOKENS=40000

# Remote Control: name under which the same session shows up in claude.ai/code and the
# Claude app (/compact, /clear and restarts stay in sync). Empty = off.
REMOTE_CONTROL=

# Claude usage (limits.py, every minute): the bot status shows "5h 71% · 1w 12%", and when
# a limit resets limits_reset.mp4 is posted with a ping to OWNER_ID. Channel IDs, comma-
# separated, first one that works wins (the rest are fallbacks). Empty = status only.
LIMITS_CHANNELS=
